# Bangumi Personal Access Token（在 https://next.bgm.tv/demo/access-token 生成）
# 复制本文件为 .env 并填入你的 token。.env 含密钥，不要提交/外传。
BGM_TOKEN=

# ---- Bangumi OAuth 登录（可选，启用登录功能才需要填）----
# 在 https://bgm.tv/dev 注册第三方应用后获得 client_id/client_secret；redirect_uri 必须与注册时一致。
# 未填时服务正常启动，仅登录功能显示"未启用"。详见 docs/DEPLOY-OAUTH.md。
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://你的域名/auth/callback
# 会话签名密钥：长随机串，保密、别提交（如 openssl rand -base64 48 生成）
SESSION_SECRET=
