# ====== 服务器 .env 模板（复制为 /opt/bgmlikes/.env，勿提交）======

# Bangumi Personal Access Token（在 https://next.bgm.tv/demo/access-token 生成）
BGM_TOKEN=

# —— Bangumi OAuth 登录（来自 bgm.tv/dev 注册的应用）——
# 回调地址必须与注册应用时填的完全一致
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://bgmhiway.asia/auth/callback

# 会话签名密钥：长随机串，保密（openssl rand -base64 48 生成）
SESSION_SECRET=